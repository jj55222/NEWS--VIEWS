# NEWS -> VIEWS Configuration
# Copy this to .env and fill in your values

# ---- Search Providers (Brave -> Tavily -> Exa fallback chain) ----
# At least one is required. Brave is primary (cheapest).

# Brave Search API (https://brave.com/search/api/) — 2,000 free/month
BRAVE_API_KEY=your-brave-api-key-here

# Tavily Search API (https://tavily.com/) — 1,000 free/month
TAVILY_API_KEY=your-tavily-api-key-here

# Exa API (https://exa.ai) — last-resort fallback
EXA_API_KEY=your-exa-api-key-here

# ---- YouTube Data API v3 (optional) ----
# Direct video evidence search. 10,000 units/day free.
YOUTUBE_API_KEY=your-youtube-api-key-here

# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# ---- Google Sheets (optional — pipeline works without it) ----
SHEET_ID=your-google-sheet-id-here
SERVICE_ACCOUNT_PATH=./service_account.json

# ---- Search Defaults (optional) ----
DEFAULT_START_DATE=2018-01-01
DEFAULT_END_DATE=2025-12-31
MAX_RESULTS_PER_REGION=30
MIN_ARTICLE_LENGTH=500

# Prescore threshold (articles below this skip LLM triage)
MIN_PRESCORE=20

# Output directories
OUTPUT_DIR=./output
LOG_DIR=./output/logs
